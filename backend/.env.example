# Copy to .env and fill in.

# Web UI accounts. The admin (you) is created/updated from these on every start;
# everyone else registers in the UI as a regular user who can only view results.
ADMIN_EMAIL=delyan.sl@gmail.com
ADMIN_PASSWORD=choose-a-long-password
# Set to true when the app is served over HTTPS (marks the login cookie Secure)
COOKIE_SECURE=false
# Set to true only when the app runs behind a reverse proxy (so rate limits use the real client address)
TRUST_PROXY=false
# Public address of this web app; the HTML report links its sign-in icon here and the
# activation e-mail links to it.
# npm run report defaults to http://127.0.0.1:<PORT> when empty.
APP_URL=http://127.0.0.1:3001

PORT=3001
HOST=127.0.0.1
DB_PATH=./data/tracker.db
SCHEDULE_TZ=Europe/Sofia

# Defaults (can be changed later in the web UI)
DEFAULT_CRON=0 9 * * *
SEARCH_QUERY=pokemon tcg

# Mail server that sends the activation e-mail. Without SMTP_HOST the link is only printed to the server log.
# Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true, SMTP_USER = your address, SMTP_PASS = an App password
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional CAPTCHA on the register / forgot-password forms (free Cloudflare Turnstile: https://dash.cloudflare.com/?to=/:account/turnstile).
# Both keys must be set to turn it on.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
