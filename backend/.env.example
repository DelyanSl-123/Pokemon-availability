# Copy to .env and fill in. Without SMTP_HOST the daily digest is only printed to the log.

# Web UI accounts. The admin (you) is created/updated from these on every start;
# everyone else registers in the UI as a regular user who can only view results.
ADMIN_EMAIL=delyan.sl@gmail.com
ADMIN_PASSWORD=choose-a-long-password
# Set to true when the app is served over HTTPS (marks the login cookie Secure)
COOKIE_SECURE=false

PORT=3001
HOST=127.0.0.1
DB_PATH=./data/tracker.db
SCHEDULE_TZ=Europe/Sofia

# Defaults (can be changed later in the web UI)
MAIL_TO=delyan.sl@gmail.com
DEFAULT_CRON=0 9 * * *
SEARCH_QUERY=pokemon tcg

# SMTP (example for Gmail: enable 2-step verification, then create an "App password")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=Pokemon Tracker <your.address@gmail.com>
